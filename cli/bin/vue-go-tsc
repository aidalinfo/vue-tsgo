#!/usr/bin/env node

const { spawn } = require('child_process');
const fs = require('fs');
const { join, posix, resolve } = require('path');
const os = require('os');

const GiB = 1024 ** 3;

// Fraction of the CPU cores a lone tsgo run may use. The Go runtime defaults
// GOMAXPROCS to every core, and tsgo parses/binds with one goroutine per file,
// so an unbounded run pins the whole machine at 100% CPU. Half of the cores
// keeps a lone typecheck fast while leaving the machine responsive.
const DEFAULT_CPU_FRACTION = 0.5;

// Fraction of total RAM used as the soft Go heap ceiling of a lone run. Half
// of RAM leaves ample headroom for the OS, Node, and other jobs.
const DEFAULT_MEM_FRACTION = 0.5;

// Fraction of total RAM shared by all concurrent runs. GOMEMLIMIT is
// per-process: without sharing, N concurrent runs would each claim 50% of RAM,
// overcommit it, and spend their time in the GC as the machine fills up.
const SHARED_MEM_FRACTION = 0.75;

// Fraction of the currently available RAM a run may claim. The rest is left as
// headroom for whatever else is running and may still grow.
const AVAILABLE_MEM_FRACTION = 0.8;

// A busy machine never squeezes a run below this fraction of the cores: the
// idle measurement is a short snapshot, and a momentary spike elsewhere must
// not cripple a typecheck for its whole duration. The kernel scheduler shares
// the cores fairly beyond that.
const MIN_CPU_FRACTION = 0.125;

// How long the launcher samples CPU activity before starting tsgo.
const CPU_SAMPLE_MS = 200;

// Fraction of a hard (cgroup) memory limit used as the soft Go heap ceiling.
// Past the hard limit the process is killed, so the GC only needs to work
// harder right before it: a lower ceiling buys nothing when the live heap
// genuinely needs more, it only makes the GC run continuously (a large Nuxt
// app ran 200 s in back-to-back GCs under a 4.1 GiB ceiling before being
// killed anyway).
const HARD_LIMIT_FRACTION = 0.9;

// Never set a heap ceiling below this: a limit under a project's live heap
// makes the Go GC run continuously instead of making progress.
const MIN_MEM_LIMIT = 1 * GiB;

// Registry entries older than this are treated as stale even if their PID is
// alive again (PID reuse after a crash that skipped cleanup).
const STALE_ENTRY_MS = 24 * 60 * 60 * 1000;

const REGISTRY_DIR = join(os.tmpdir(), 'vue-go-tsc-instances');

// Codegen modes. `volar` (default) generates the .vue virtual code with
// `@vue/language-core` — the codegen vue-tsc itself runs, taken from the
// project's vue-tsc — so results match vue-tsc; type-checking stays in tsgo.
// `go` uses the built-in Go port of the codegen (faster, but it can only match
// one Volar version and may lag behind it).
const CODEGEN_MODES = ['volar', 'go'];
const DEFAULT_CODEGEN = 'volar';

// Approximate resident memory of the Volar codegen Node processes (measured
// ~180 MB per worker thread on a Nuxt app, plus the main thread). Reserved
// out of the Go heap ceiling so both fit in the machine's budget.
const VOLAR_BASE_MEM = 200 * 1024 ** 2;
const VOLAR_WORKER_MEM = 200 * 1024 ** 2;
const MAX_CODEGEN_WORKERS = 4;

// Compute GOMAXPROCS for one of `instances` concurrent runs on a machine with
// `cpus` cores of which `idleCpus` are currently idle.
//
// The run takes the smallest of: half of the cores, its fair share when
// several runs are active, and the cores other work leaves idle. It is never
// squeezed below MIN_CPU_FRACTION of the cores (and at least one core).
// `idleCpus` is optional: when unknown, only the first two bounds apply.
//
// Returns null when the core count is unknown (leave Go's default).
function computeGoMaxProcs(cpus, instances = 1, idleCpus) {
  if (!Number.isFinite(cpus) || cpus <= 0) {
    return null;
  }
  const n = Math.max(1, Math.floor(instances) || 1);
  const cap = Math.max(1, Math.min(Math.floor(cpus * DEFAULT_CPU_FRACTION), Math.floor(cpus / n)));
  if (!Number.isFinite(idleCpus) || idleCpus < 0) {
    return cap;
  }
  const floor = Math.min(cap, Math.max(1, Math.floor(cpus * MIN_CPU_FRACTION)));
  return Math.max(floor, Math.min(cap, Math.floor(idleCpus)));
}

// Number of idle cores between two `os.cpus()` snapshots, scaled to the
// `cpus` usable by this process. Returns undefined when nothing was measured.
function measureIdleCpus(before, after, cpus) {
  let idle = 0;
  let total = 0;
  for (let i = 0; i < Math.min(before.length, after.length); i++) {
    const a = before[i].times;
    const b = after[i].times;
    const idleDelta = b.idle - a.idle;
    const totalDelta = b.user + b.nice + b.sys + b.idle + b.irq - (a.user + a.nice + a.sys + a.idle + a.irq);
    idle += Math.max(0, idleDelta);
    total += Math.max(0, totalDelta);
  }
  if (total <= 0) {
    return undefined;
  }
  return (idle / total) * cpus;
}

// Compute a soft Go heap ceiling (in bytes) for one of `instances` concurrent
// runs based on total RAM.
//
// tsgo is the typescript-go native binary; its Go runtime defaults to GOGC=100,
// which lets the heap roughly double before the GC runs. On a large Nuxt
// project that transient spike can exceed physical RAM and get the process
// OOM-killed by the kernel. Setting GOMEMLIMIT makes the GC increasingly
// aggressive as the heap approaches the limit, trading CPU for staying under
// the ceiling. It is a *soft* limit — swap absorbs any remaining overshoot
// instead of a hard kill, and it can be raised via the GOMEMLIMIT env var when
// a project's live heap genuinely needs more.
//
// A lone run gets at most half of RAM; concurrent runs split a shared pool so
// their combined ceilings stay below physical RAM. The run also never claims
// more than AVAILABLE_MEM_FRACTION of the RAM currently available
// (`availableBytes`, optional), so memory held by other programs is left
// alone. The fair-share bound still matters on top of that: other runs that
// just started have not grown their heap yet.
//
// Returns null when total RAM is unknown/implausible (leave Go's default).
function computeGoMemLimit(totalBytes, instances = 1, availableBytes) {
  if (!Number.isFinite(totalBytes) || totalBytes <= 0) {
    return null;
  }
  const n = Math.max(1, Math.floor(instances) || 1);
  let share = Math.min(totalBytes * DEFAULT_MEM_FRACTION, (totalBytes * SHARED_MEM_FRACTION) / n);
  if (Number.isFinite(availableBytes) && availableBytes >= 0) {
    share = Math.min(share, availableBytes * AVAILABLE_MEM_FRACTION);
  }
  return Math.floor(Math.max(Math.min(MIN_MEM_LIMIT, totalBytes * DEFAULT_MEM_FRACTION), share));
}

// Split `--codegen=<mode>` / `--codegen <mode>` out of the tsgo arguments.
// The VUE_GO_TSC_CODEGEN env var sets the default; the flag wins.
function parseCodegenArgs(argv, env = {}) {
  let codegen = env.VUE_GO_TSC_CODEGEN || DEFAULT_CODEGEN;
  const args = [];
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === '--codegen') {
      codegen = argv[++i];
    } else if (arg.startsWith('--codegen=')) {
      codegen = arg.slice('--codegen='.length);
    } else {
      args.push(arg);
    }
  }
  if (!CODEGEN_MODES.includes(codegen)) {
    return { args, error: `invalid codegen mode ${JSON.stringify(codegen)} (expected ${CODEGEN_MODES.join(' or ')})` };
  }
  return { codegen, args };
}

// The tsconfig tsgo will check, for the Volar codegen to read its
// vueCompilerOptions: `-p/--project <file|dir>`, the first `-b/--build`
// project, or ./tsconfig.json.
function resolveProjectConfig(args, cwd, isDirectory = (p) => fs.statSync(p).isDirectory()) {
  let target;
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg === '-p' || arg === '--project') {
      target = args[i + 1];
      break;
    }
    if (arg.startsWith('--project=')) {
      target = arg.slice('--project='.length);
      break;
    }
    if ((arg === '-b' || arg === '--build') && args[i + 1] && !args[i + 1].startsWith('-')) {
      target = args[i + 1];
      break;
    }
  }
  const resolved = resolve(cwd, target ?? '.');
  let dir = false;
  try {
    dir = isDirectory(resolved);
  } catch {}
  return dir ? join(resolved, 'tsconfig.json') : resolved;
}

// Number of Volar codegen worker threads: half the Go cores (codegen overlaps
// with tsgo's own parsing), at most MAX_CODEGEN_WORKERS, fewer when free RAM is
// short (a worker must not take more than 1/8 of the available memory).
function computeCodegenWorkers(procs, availableMem) {
  let workers = Math.min(MAX_CODEGEN_WORKERS, Math.max(1, Math.floor((procs || 2) / 2)));
  if (Number.isFinite(availableMem) && availableMem > 0) {
    workers = Math.min(workers, Math.max(1, Math.floor(availableMem / 8 / VOLAR_WORKER_MEM)));
  }
  return workers;
}

// Soft Go heap ceiling under a hard memory limit (cgroup): most of it, shared
// between the concurrent runs (they are all inside the same limit).
function computeHardGoMemLimit(hardLimit, instances = 1) {
  if (!Number.isFinite(hardLimit) || hardLimit <= 0) {
    return null;
  }
  const n = Math.max(1, Math.floor(instances) || 1);
  return Math.floor((hardLimit * HARD_LIMIT_FRACTION) / n);
}

// Return a copy of `env` with GOMAXPROCS and GOMEMLIMIT defaulted from the
// machine resources, what is currently free, and the number of concurrent
// runs. Explicit values are always respected (never overridden). With the
// Volar codegen, its Node processes get a share of the memory budget.
//
// `hardLimit` is the cgroup memory limit, when there is one: exceeding it gets
// the process killed, so the ceiling follows it rather than the RAM that
// happens to be free when the run starts.
function resolveEnv(env, { cpus, totalMem, instances = 1, idleCpus, availableMem, hardLimit, codegen = 'go', volar }) {
  const out = { ...env };
  if (!out.GOMAXPROCS) {
    const procs = computeGoMaxProcs(cpus, instances, idleCpus);
    if (procs) {
      out.GOMAXPROCS = String(procs);
    }
  }
  let workers = 0;
  if (codegen === 'volar') {
    workers = Number(out.GOLAR_PLUGIN_WORKERS) || computeCodegenWorkers(Number(out.GOMAXPROCS), availableMem);
    out.GOLAR_PLUGIN = 'vue';
    out.GOLAR_PLUGIN_WORKERS = String(workers);
    if (volar) {
      out.GOLAR_VUE_PLUGIN_ENTRY = volar.pluginEntry;
      out.GOLAR_NODE = volar.nodePath;
      out.GOLAR_VUE_TSCONFIG = volar.tsconfig;
    }
  } else {
    delete out.GOLAR_PLUGIN;
  }
  if (!out.GOMEMLIMIT) {
    let limit = computeHardGoMemLimit(hardLimit, instances) ?? computeGoMemLimit(totalMem, instances, availableMem);
    if (limit && workers > 0) {
      limit = Math.floor(Math.max(Math.min(MIN_MEM_LIMIT, limit), limit - VOLAR_BASE_MEM - workers * VOLAR_WORKER_MEM));
    }
    if (limit) {
      // A bare integer is interpreted by the Go runtime as a byte count.
      out.GOMEMLIMIT = String(limit);
    }
  }
  return out;
}

function isProcessAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (err) {
    // EPERM: the process exists but belongs to another user.
    return err.code === 'EPERM';
  }
}

// Register this run in the shared instance registry and return the number of
// live runs (including this one) plus a function that unregisters it.
//
// Each run owns one `<pid>` file in `dir`. Entries whose process is gone (a
// run killed before it could clean up) are pruned on the way. Registering
// before counting means two runs starting at the same moment see each other.
// Any filesystem failure degrades to "alone" rather than blocking the check.
function registerInstance(dir = REGISTRY_DIR, pid = process.pid, now = Date.now()) {
  const self = join(dir, String(pid));
  try {
    fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(self, String(now));
  } catch {
    return { instances: 1, unregister: () => {} };
  }

  let instances = 1;
  try {
    for (const name of fs.readdirSync(dir)) {
      const other = Number(name);
      if (!Number.isInteger(other) || other <= 0 || other === pid) {
        continue;
      }
      const entry = join(dir, name);
      let startedAt = NaN;
      try {
        startedAt = Number(fs.readFileSync(entry, 'utf8'));
      } catch {
        continue;
      }
      if (isProcessAlive(other) && now - startedAt < STALE_ENTRY_MS) {
        instances++;
      } else {
        try {
          fs.unlinkSync(entry);
        } catch {}
      }
    }
  } catch {}

  return {
    instances,
    unregister: () => {
      try {
        fs.unlinkSync(self);
      } catch {}
    },
  };
}

// Usable core count: honors CPU affinity (taskset, container cpusets).
function availableCpus() {
  return typeof os.availableParallelism === 'function' ? os.availableParallelism() : os.cpus().length;
}

// cgroup limits at or above this are "unlimited" (cgroup v1 reports a huge
// page-aligned number instead of "max").
const CGROUP_UNLIMITED = 2 ** 60;

function parseCgroupBytes(text) {
  const value = Number(String(text).trim());
  return Number.isFinite(value) && value > 0 && value < CGROUP_UNLIMITED ? value : undefined;
}

// The tightest cgroup memory limit of this process and the usage counted
// against it: { limit, usage } (usage may be undefined), or undefined when
// there is none (or not on Linux).
//
// process.constrainedMemory() only reads the process's own cgroup, but a CI
// job or container runtime often sets the limit on a parent (the job's slice)
// and leaves the leaf unlimited, so this walks from the process's cgroup up to
// the root and keeps the smallest memory.max / memory.high (v2) or
// memory.limit_in_bytes (v1).
function cgroupMemoryLimit(readFile = (p) => fs.readFileSync(p, 'utf8'), root = '/sys/fs/cgroup') {
  let membership;
  try {
    membership = readFile('/proc/self/cgroup');
  } catch {
    return undefined;
  }
  let best;
  const read = (file) => {
    try {
      return readFile(file);
    } catch {
      return undefined;
    }
  };
  for (const line of membership.split('\n')) {
    // <hierarchy-id>:<controllers>:<path>; the path itself may contain ':'.
    const first = line.indexOf(':');
    const second = line.indexOf(':', first + 1);
    if (first < 0 || second < 0) {
      continue;
    }
    const id = line.slice(0, first);
    const controllers = line.slice(first + 1, second).split(',');
    let dir = line.slice(second + 1);
    let base;
    let files;
    if (id === '0' && controllers.length === 1 && controllers[0] === '') {
      base = root;
      files = { limits: ['memory.max', 'memory.high'], usage: 'memory.current' };
    } else if (controllers.includes('memory')) {
      base = join(root, 'memory');
      files = { limits: ['memory.limit_in_bytes'], usage: 'memory.usage_in_bytes' };
    } else {
      continue;
    }
    for (;;) {
      const cgroupDir = join(base, dir);
      for (const name of files.limits) {
        const limit = parseCgroupBytes(read(join(cgroupDir, name)));
        if (limit !== undefined && (!best || limit < best.limit)) {
          best = { limit, usage: parseCgroupBytes(read(join(cgroupDir, files.usage))) };
        }
      }
      if (dir === '/' || dir === '') {
        break;
      }
      dir = posix.dirname(dir);
    }
  }
  return best;
}

// Usable RAM: honors a cgroup memory limit (containers, CI jobs) when it is
// tighter than physical RAM, including a limit set on a parent cgroup.
function totalMemory(cgroup = cgroupMemoryLimit()) {
  let total = os.totalmem();
  const constrained = typeof process.constrainedMemory === 'function' ? process.constrainedMemory() : 0;
  if (constrained > 0 && constrained < total) {
    total = constrained;
  }
  return cgroup && cgroup.limit < total ? cgroup.limit : total;
}

// RAM currently available to this process (MemAvailable on Linux, bounded by
// the cgroup limit when there is one).
function freeMemory(cgroup = cgroupMemoryLimit()) {
  const available = typeof process.availableMemory === 'function' ? process.availableMemory() : os.freemem();
  if (cgroup && cgroup.usage !== undefined) {
    return Math.min(available, Math.max(0, cgroup.limit - cgroup.usage));
  }
  return available;
}

// Idle cores right now, sampled over CPU_SAMPLE_MS.
function sampleIdleCpus(cpus) {
  const before = os.cpus();
  return new Promise((resolve) => {
    setTimeout(() => resolve(measureIdleCpus(before, os.cpus(), cpus)), CPU_SAMPLE_MS);
  });
}

async function main() {
  const BINARY_NAME = process.platform === 'win32' ? 'tsgo.exe' : 'tsgo';
  const BIN_PATH = join(__dirname, BINARY_NAME);
  const VOLAR_PLUGIN = join(__dirname, '..', 'volar', 'plugin.mjs');

  const { codegen, args, error } = parseCodegenArgs(process.argv.slice(2), process.env);
  if (error) {
    console.error(`vue-go-tsc: ${error}`);
    process.exit(1);
  }
  if (codegen === 'volar' && !fs.existsSync(VOLAR_PLUGIN)) {
    console.error(`vue-go-tsc: the Volar codegen plugin is missing (${VOLAR_PLUGIN}); reinstall vue-go-tsc or use --codegen=go`);
    process.exit(1);
  }

  const { instances, unregister } = registerInstance();
  process.on('exit', unregister);

  const cpus = availableCpus();
  // Sampling costs CPU_SAMPLE_MS of startup; skip it when it cannot matter.
  const idleCpus = process.env.GOMAXPROCS ? undefined : await sampleIdleCpus(cpus);

  const cgroup = cgroupMemoryLimit();
  const env = resolveEnv(process.env, {
    cpus,
    totalMem: totalMemory(cgroup),
    instances,
    idleCpus,
    availableMem: freeMemory(cgroup),
    hardLimit: cgroup?.limit,
    codegen,
    volar: {
      pluginEntry: VOLAR_PLUGIN,
      nodePath: process.execPath,
      tsconfig: resolveProjectConfig(args, process.cwd()),
    },
  });

  // Forward the remaining arguments to the binary
  const child = spawn(BIN_PATH, args, {
    stdio: 'inherit',
    shell: false,
    env,
  });

  // Keep the launcher alive until tsgo exits so the registry entry stays
  // accurate; tsgo receives terminal signals directly from the process group,
  // and signals sent to the launcher alone are forwarded.
  for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
    process.on(signal, () => {
      child.kill(signal);
    });
  }

  child.on('error', (err) => {
    console.error(`vue-go-tsc: failed to start ${BIN_PATH}: ${err.message}`);
    if (['ENOENT', 'EACCES', 'ENOEXEC'].includes(err.code)) {
      // Missing, non-executable or truncated binary (e.g. an interrupted
      // install, or a package manager that skipped the postinstall script).
      console.error(
        `vue-go-tsc: the tsgo binary is missing or broken; reinstall it with:\n` +
          `  node ${join(__dirname, '..', 'install.js')}`
      );
    }
    process.exit(1);
  });

  child.on('exit', (code, signal) => {
    if (signal) {
      // Report a killed tsgo (e.g. OOM killer) as a failure, not a success.
      const signum = os.constants.signals[signal];
      process.exit(signum ? 128 + signum : 1);
    }
    process.exit(code ?? 1);
  });
}

if (require.main === module) {
  main();
}

module.exports = {
  parseCodegenArgs,
  resolveProjectConfig,
  computeCodegenWorkers,
  computeGoMaxProcs,
  computeGoMemLimit,
  computeHardGoMemLimit,
  measureIdleCpus,
  resolveEnv,
  registerInstance,
  cgroupMemoryLimit,
  GiB,
  DEFAULT_CPU_FRACTION,
  DEFAULT_MEM_FRACTION,
  SHARED_MEM_FRACTION,
  MIN_MEM_LIMIT,
  AVAILABLE_MEM_FRACTION,
  MIN_CPU_FRACTION,
};
